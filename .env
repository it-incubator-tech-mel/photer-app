#  .env 

# Базовый адрес API (используется в RTK Query и fetch)
NEXT_PUBLIC_BASE_URL=https://photer.ltd/api/v1

# Google ReCAPTCHA site key
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeZReQqAAAAAJ-4OO2JYFnhUGFbeCdiBjlJ56kj

# Включить/отключить авторизацию и refresh-token
NEXT_PUBLIC_ENABLE_AUTH=false
